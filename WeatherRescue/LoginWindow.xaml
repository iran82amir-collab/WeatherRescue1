<Window x:Class="WeatherRescue.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WeatherRescue - Login"
        Height="600" Width="950"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#101827">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Section -->
        <Border Grid.Column="0" Background="#17263B">
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Margin="35">

                <TextBlock Text="WEATHER"
                           FontSize="38"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="RESCUE"
                           FontSize="38"
                           FontWeight="Bold"
                           Foreground="#29C7B8"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Smart Weather &amp; Emergency System"
                           Foreground="#AAB8CC"
                           FontSize="15"
                           Margin="0,15,0,35"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Stay informed. Stay safe."
                           Foreground="White"
                           FontSize="19"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Right Section -->
        <Grid Grid.Column="1" Margin="45">
            <StackPanel VerticalAlignment="Center">

                <TextBlock Text="Welcome Back"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="White"/>

                <TextBlock Text="Sign in to your account"
                           Foreground="#9BAAC0"
                           FontSize="14"
                           Margin="0,8,0,35"/>

                <TextBlock Text="Phone Number"
                           Foreground="White"
                           FontSize="14"
                           Margin="0,0,0,8"/>

                <TextBox x:Name="PhoneTextBox"
                         Height="43"
                         FontSize="15"
                         Padding="10"
                         Background="#202E42"
                         Foreground="White"
                         BorderBrush="#35465E"/>

                <TextBlock Text="Password"
                           Foreground="White"
                           FontSize="14"
                           Margin="0,22,0,8"/>

                <PasswordBox x:Name="PasswordBox"
                             Height="43"
                             FontSize="15"
                             Padding="10"
                             Background="#202E42"
                             Foreground="White"
                             BorderBrush="#35465E"/>

                <Button Content="SIGN IN"
                        Height="46"
                        Margin="0,30,0,15"
                        Background="#20BFAF"
                        Foreground="White"
                        FontWeight="Bold"
                        FontSize="15"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="Login_Click"/>

                <TextBlock Text="Don't have an account?"
                           Foreground="#AAB8CC"
                           HorizontalAlignment="Center"/>
                <Button Content="Create Account"
                        Background="Transparent"
                        Foreground="#29C7B8"
                        BorderThickness="0"
                        FontWeight="Bold"
                        Cursor="Hand"
                        Click="Register_Click"/>

            </StackPanel>
        </Grid>
    </Grid>
</Window>