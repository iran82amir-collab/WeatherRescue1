<Window x:Class="WeatherRescue.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WeatherRescue - Register"
        Height="650" Width="950"
        WindowStartupLocation="CenterScreen"
        Background="#101827">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#17263B">
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center">

                <TextBlock Text="WEATHER"
                           FontSize="38"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="RESCUE"
                           FontSize="38"
                           FontWeight="Bold"
                           Foreground="#29C7B8"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Create your account"
                           Foreground="#AAB8CC"
                           FontSize="16"
                           Margin="0,20,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Column="1"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="45" VerticalAlignment="Center">

                <TextBlock Text="Create Account"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="0,0,0,25"/>

                <TextBlock Text="Full Name" Foreground="White" Margin="0,0,0,7"/>
                <TextBox x:Name="FullNameTextBox"
                         Height="40" FontSize="15" Padding="8"
                         Background="#202E42" Foreground="White"
                         BorderBrush="#35465E"/>

                <TextBlock Text="Phone Number" Foreground="White" Margin="0,17,0,7"/>
                <TextBox x:Name="PhoneTextBox"
                         Height="40" FontSize="15" Padding="8"
                         Background="#202E42" Foreground="White"
                         BorderBrush="#35465E"/>

                <TextBlock Text="Password" Foreground="White" Margin="0,17,0,7"/>
                <PasswordBox x:Name="PasswordBox"
                             Height="40" FontSize="15" Padding="8"
                             Background="#202E42" Foreground="White"
                             BorderBrush="#35465E"/>

                <TextBlock Text="Confirm Password" Foreground="White" Margin="0,17,0,7"/>
                <PasswordBox x:Name="ConfirmPasswordBox"
                             Height="40" FontSize="15" Padding="8"
                             Background="#202E42" Foreground="White"
                             BorderBrush="#35465E"/>

                <Button Content="CREATE ACCOUNT"
                        Height="45" Margin="0,25,0,12"
                        Background="#20BFAF" Foreground="White"
                        FontWeight="Bold" FontSize="14"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="Register_Click"/>

                <Button Content="Back to Login"
                        Height="35"
                        Background="Transparent"
                        Foreground="#29C7B8"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="BackToLogin_Click"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>