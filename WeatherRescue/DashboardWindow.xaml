<Window x:Class="WeatherRescue.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WeatherRescue - Dashboard"
        Height="750" Width="1200"
        MinHeight="650" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="#101827">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="245"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="#17263B">
            <DockPanel LastChildFill="True">

                <StackPanel DockPanel.Dock="Top" Margin="22,30,15,25">
                    <TextBlock Text="WEATHER"
                               FontSize="25"
                               FontWeight="Bold"
                               Foreground="White"/>

                    <TextBlock Text="RESCUE"
                               FontSize="25"
                               FontWeight="Bold"
                               Foreground="#29C7B8"/>

                    <TextBlock Text="EMERGENCY MANAGEMENT"
                               FontSize="9"
                               Foreground="#91A3BA"
                               Margin="0,8,0,0"/>
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="MAIN MENU"
                               Foreground="#71849E"
                               FontSize="11"
                               Margin="22,10,0,12"/>

                    <Button Content="Dashboard"
                            Height="45"
                            Background="#25445A"
                            Foreground="#29C7B8"
                            BorderThickness="0"
                            HorizontalContentAlignment="Left"
                            Padding="22,0"/>

                    <Button Content="Weather Alerts"
                            Height="45"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                            HorizontalContentAlignment="Left"
                            Padding="22,0"/>

                    <Button Content="Air Quality"
                            Height="45"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                            HorizontalContentAlignment="Left"
                            Padding="22,0"/>

                    <Button Content="Emergency Request"
                            Height="45"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                            HorizontalContentAlignment="Left"
                            Padding="22,0"/>

                    <Button Content="My Requests"
                            Height="45"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                            HorizontalContentAlignment="Left"
                            Padding="22,0"/>

                    <Button Content="My Profile"
                            Height="45"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                            HorizontalContentAlignment="Left"
                            Padding="22,0"/>
                </StackPanel>

                <Button Content="LOG OUT"
                        DockPanel.Dock="Bottom"
                        Height="45"
                        Margin="18"
                        Background="#27384E"
                        Foreground="#FF7777"
                        BorderThickness="0"
                        Click="Logout_Click"/>
            </DockPanel>
        </Border>
        <!-- Main Content -->
        <ScrollViewer Grid.Column="1"
                      VerticalScrollBarVisibility="Auto">

            <StackPanel Margin="35">

                <Grid Margin="0,0,0,30">
                    <StackPanel>
                        <TextBlock Text="Dashboard"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <TextBlock x:Name="WelcomeText"
                                   Text="Welcome to your safety center"
                                   FontSize="14"
                                   Foreground="#91A3BA"
                                   Margin="0,7,0,0"/>
                    </StackPanel>

                    <TextBlock Text="WEATHERRESCUE"
                               Foreground="#29C7B8"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               FontWeight="Bold"/>
                </Grid>

                <TextBlock Text="OVERVIEW"
                           Foreground="#91A3BA"
                           FontSize="12"
                           Margin="0,0,0,15"/>

                <UniformGrid Columns="3" Margin="0,0,0,30">

                    <Border Background="#1B3046"
                            CornerRadius="10"
                            Padding="20"
                            Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="Weather Alerts"
                                       Foreground="#91A3BA"
                                       FontSize="13"/>
                            <TextBlock Text="--"
                                       Foreground="#29C7B8"
                                       FontSize="32"
                                       FontWeight="Bold"
                                       Margin="0,10,0,0"/>
                            <TextBlock Text="Active alerts"
                                       Foreground="#71849E"
                                       FontSize="11"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#1B3046"
                            CornerRadius="10"
                            Padding="20"
                            Margin="6,0">
                        <StackPanel>
                            <TextBlock Text="Air Quality"
                                       Foreground="#91A3BA"
                                       FontSize="13"/>
                            <TextBlock Text="--"
                                       Foreground="#29C7B8"
                                       FontSize="32"
                                       FontWeight="Bold"
                                       Margin="0,10,0,0"/>
                            <TextBlock Text="AQI Status"
                                       Foreground="#71849E"
                                       FontSize="11"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#1B3046"
                            CornerRadius="10"
                            Padding="20"
                            Margin="12,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Help Requests"
                                       Foreground="#91A3BA"
                                       FontSize="13"/>
                            <TextBlock Text="0"
                                       Foreground="#29C7B8"
                                       FontSize="32"
                                       FontWeight="Bold"
                                       Margin="0,10,0,0"/>
                            <TextBlock Text="Your requests"
                                       Foreground="#71849E"
                                       FontSize="11"/>
                        </StackPanel>
                    </Border>

                </UniformGrid>
                <Border Background="#1B3046"
                        CornerRadius="12"
                        Padding="25"
                        Margin="0,0,0,22">

                    <StackPanel>
                        <TextBlock Text="Emergency Assistance"
                                   Foreground="White"
                                   FontSize="21"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Need immediate assistance? Submit an emergency request."
                                   Foreground="#91A3BA"
                                   FontSize="13"
                                   Margin="0,12,0,20"
                                   TextWrapping="Wrap"/>

                        <Button Content="REQUEST HELP"
                                Width="180"
                                Height="45"
                                HorizontalAlignment="Left"
                                Background="#D9535D"
                                Foreground="White"
                                FontWeight="Bold"
                                BorderThickness="0"/>
                    </StackPanel>
                </Border>

                <Border Background="#1B3046"
                        CornerRadius="12"
                        Padding="25">

                    <StackPanel>
                        <TextBlock Text="Recent Weather Alerts"
                                   Foreground="White"
                                   FontSize="19"
                                   FontWeight="Bold"/>

                        <TextBlock Text="No weather alerts to display."
                                   Foreground="#91A3BA"
                                   Margin="0,18,0,0"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>